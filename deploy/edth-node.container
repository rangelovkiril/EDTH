# Rootful Podman quadlet for the detection node: /etc/containers/systemd/edth-node.container
# Installed by bootstrap.sh. Machine-specific settings live in /etc/edth/node.env, never in git.
[Unit]
Description=EDTH detection node
Wants=network-online.target
After=network-online.target
# Never give up restarting.
StartLimitIntervalSec=0

[Container]
Image=ghcr.io/rangelovkiril/edth-node:latest
ContainerName=edth-node
# New images arrive by themselves: podman-auto-update.timer (every minute, see bootstrap.sh) checks
# the registry, pulls a changed :latest and restarts this unit, and rolls back to the previous image
# if the new one does not become healthy. Nothing has to reach the Pi from outside.
AutoUpdate=registry
# After a reboot the image is already local, so no network is needed to start.
Pull=missing
EnvironmentFile=/etc/edth/node.env
Network=host
# libcamera opens /dev/media*, /dev/v4l-subdev*, /dev/video* and /dev/dma_heap/*, whose numbers
# change between boots, so list-based device passthrough is brittle here.
PodmanArgs=--privileged
Volume=/run/udev:/run/udev:ro
LogDriver=journald

# Healthy = frames are flowing: the node touches /tmp/edth-alive each second it processed a frame.
# A hung camera stops the file moving, podman kills the container, and Restart=always starts it
# again. Notify=healthy makes systemd (and auto-update) wait for the first good check, which is
# what lets auto-update tell a working new image from a broken one.
HealthCmd=python -c 'import os,sys,time; sys.exit(time.time()-os.stat("/tmp/edth-alive").st_mtime>30)'
HealthInterval=15s
HealthTimeout=10s
HealthRetries=3
HealthStartPeriod=90s
HealthOnFailure=kill
Notify=healthy

[Service]
Restart=always
RestartSec=5
# The first start also pulls the image over whatever network there is.
TimeoutStartSec=900
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
