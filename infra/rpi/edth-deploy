#!/bin/sh
# Forced command for the CI deploy key (see README.md). The only input is the image tag
# in $SSH_ORIGINAL_COMMAND, validated as sha-<7..40 hex>. Nothing else can be run.
set -eu

IMAGE=ghcr.io/rangelovkiril/edth-node
UNIT=edth-node.service

tag=${SSH_ORIGINAL_COMMAND:-}
hex=${tag#sha-}
case "$hex" in
  '' | *[!0-9a-f]*) echo "edth-deploy: invalid tag" >&2; exit 2 ;;
esac
if [ "$hex" = "$tag" ] || [ "${#hex}" -lt 7 ] || [ "${#hex}" -gt 40 ]; then
  echo "edth-deploy: invalid tag" >&2
  exit 2
fi

export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"

podman pull "$IMAGE:$tag"
podman tag "$IMAGE:$tag" "$IMAGE:latest"
systemctl --user restart "$UNIT"
sleep 3
systemctl --user is-active --quiet "$UNIT" || {
  systemctl --user status "$UNIT" --no-pager || true
  exit 1
}
podman image prune -f >/dev/null
echo "edth-deploy: $UNIT running $tag"
