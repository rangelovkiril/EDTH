# Copy to ~/.config/edth/node.env on the Pi (chmod 600). The MQTT password is NOT here:
# it comes from the podman secret edth-mqtt-password.
NODE_ID=rpi-1
MQTT_HOST=mqtt.example.com
MQTT_PORT=8883
MQTT_USERNAME=rpi-1

CAMERA_DEVICE=0
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
CAMERA_HFOV_DEG=70

# Mount pose: heading clockwise from true north, pitch up, roll clockwise.
NODE_HEADING_DEG=0
NODE_PITCH_DEG=0
NODE_ROLL_DEG=0

NTP_SERVER=pool.ntp.org
