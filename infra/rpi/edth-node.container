# Rootless Podman quadlet. Install to ~/.config/containers/systemd/ (see README.md).
[Unit]
Description=EDTH detection node
Wants=network-online.target
After=network-online.target

[Container]
Image=ghcr.io/rangelovkiril/edth-node:latest
ContainerName=edth-node
# edth-deploy pulls and retags; this only fetches on first start.
Pull=missing
# Private GHCR pull: podman reads ~/.config/containers/auth.json (classic PAT, read:packages).
EnvironmentFile=%h/.config/edth/node.env
# podman secret create edth-mqtt-password -
Secret=edth-mqtt-password,type=env,target=MQTT_PASSWORD
# USB camera via V4L2. A CSI/libcamera camera needs /dev/media*, /dev/v4l-subdev* and dma_heap too.
AddDevice=/dev/video0
GroupAdd=keep-groups
LogDriver=journald

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=300

[Install]
WantedBy=default.target
