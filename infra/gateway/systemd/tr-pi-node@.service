[Unit]
Description=Triangulum Pi camera node %i
After=tr-ingest.service

[Service]
User=triangulum
SupplementaryGroups=video
EnvironmentFile=-/etc/triangulum/pi-node-%i.env
ExecStart=/opt/triangulum/.venv/bin/tr-pi-node --node-id %i --source ${TR_SOURCE}
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
