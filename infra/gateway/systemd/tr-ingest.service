[Unit]
Description=Triangulum UDP ingest
After=network-online.target mosquitto.service
Wants=network-online.target

[Service]
User=triangulum
StateDirectory=triangulum
ExecStart=/opt/triangulum/.venv/bin/tr-ingest --mqtt-host 127.0.0.1 --record-dir /var/lib/triangulum/recordings
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
