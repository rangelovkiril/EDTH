# Rootless Podman quadlet, installed by deploy.py to ~/.config/containers/systemd/.
[Unit]
Description=EDTH detection node
Wants=network-online.target
After=network-online.target

[Container]
Image=ghcr.io/rangelovkiril/edth-node:latest
ContainerName=edth-node
# deploy.py pulls the wanted tag and retags it :latest; this only fetches on a bare first start.
Pull=missing
EnvironmentFile=%h/.config/edth/node.env
# Created by deploy.py from the local deploy.env: podman secret create edth-mqtt-password -
Secret=edth-mqtt-password,type=env,target=MQTT_PASSWORD
# USB camera via V4L2. A CSI/libcamera camera needs /dev/media*, /dev/v4l-subdev* and dma_heap too.
AddDevice=/dev/video0
GroupAdd=keep-groups
ReadOnly=true
NoNewPrivileges=true
DropCapability=ALL
LogDriver=journald

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=300

[Install]
WantedBy=default.target
