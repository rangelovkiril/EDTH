# Copy to deploy.env (gitignored). Shared settings for every Pi; per-Pi overrides go in pis.json.
# Written to ~/.config/edth/node.env on each Pi. NODE_ID and MQTT_USERNAME are set from pis.json.
MQTT_HOST=mqtt.example.com
MQTT_PORT=8883
MQTT_TLS=1

CAMERA_DEVICE=0
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
CAMERA_HFOV_DEG=70
NODE_PITCH_DEG=0
NODE_ROLL_DEG=0

# Passwords never reach the env file: they become the podman secret edth-mqtt-password.
# Per Pi (id upper-cased, '-' -> '_'), or one shared MQTT_PASSWORD.
MQTT_PASSWORD_RPI_1=change-me
MQTT_PASSWORD_RPI_2=change-me
